{
  "name": "remedios-app-flutter",
  "private": true,
  "scripts": {
    "test:api": "node --test \"server/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verify:api": "esbuild api/read-card.ts --bundle --platform=node --target=node20 --format=cjs --outfile=node_modules/.cache/read-card.cjs && node -e \"require('./node_modules/.cache/read-card.cjs')\"",
    "package:cjs": "node scripts/package-cjs-functions.mjs",
    "inject:ocr-assets": "node scripts/inject-ocr-assets.mjs",
    "verify:build": "node scripts/verify-vercel-build.mjs"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
