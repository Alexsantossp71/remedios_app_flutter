{
  "name": "remedios-app-e2e",
  "version": "1.0.0",
  "description": "E2E tests for Remedios App Flutter Web using Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install"
  },
  "keywords": ["e2e", "testing", "playwright", "flutter", "remedios-app"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}